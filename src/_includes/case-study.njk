---
layout: base.njk
---
{#-
  Layout for one case study. Each file in content/projects/ uses it (see
  content/projects/projects.11tydata.js). The Markdown body is inserted into
  .prose. The project's data (status, tags, demo, code link) comes from
  data/projects.json, matched by the file name.
-#}
{%- from "macros.njk" import externalLink -%}
{%- set root = page.url | rootPath -%}
{#- The matching project entry, or nothing if the slug is not in projects.json. -#}
{%- set project = projects | findBySlug(page.fileSlug) -%}
<article class="case-study">
  <p><a href="{{ root }}projects/">&larr; All projects</a></p>
  <h1>{{ title }}</h1>
  <p class="lead">{{ summary }}</p>
  {%- if project and project.status %}
  <p class="status status-{{ project.status | slugify }}">{{ project.status }}</p>
  {%- endif %}
  {%- if project %}
  <ul class="tags" aria-label="Technologies">
    {%- for tag in project.tags %}
    <li>{{ tag }}</li>
    {%- endfor %}
  </ul>
  {%- endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  <ul class="card-links case-study-links">
    <li><a href="{{ root }}projects/">Back to all projects</a></li>
    {%- if project and project.demo and not (demos | findBySlug(project.demo)).hidden %}
    <li><a href="{{ root }}demos/{{ project.demo }}/">Try the demo</a></li>
    {%- endif %}
    {%- if project %}
    <li>{{ externalLink(project.codeUrl, "Source repository", title) }}</li>
    {%- endif %}
  </ul>
</article>
