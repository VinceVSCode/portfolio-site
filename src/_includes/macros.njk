{#
  Reusable template pieces. Import them in a page with:
    {% from "macros.njk" import externalLink, projectCard %}
#}

{# External link. Shows plain text while the value is still a placeholder.
   url: the address; label: the link text; context: optional extra text for
   screen readers; cssClass: optional CSS class for the link. #}
{% macro externalLink(url, label, context, cssClass) -%}
{%- if url | isPlaceholder -%}
<span class="pending">{{ label }}: {{ url or "[NOT SET]" }}</span>
{%- else -%}
<a{% if cssClass %} class="{{ cssClass }}"{% endif %} href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ label }}{% if context %}<span class="visually-hidden">: {{ context }}</span>{% endif %}</a>
{%- endif -%}
{%- endmacro %}

{# Project card, used on the home page and the projects list.
   project: one entry from the catalog (data/projects.json merged with the
   GitHub manifests, see data/catalog.js); root: path back to site root;
   headingLevel: 2 or 3, so headings nest correctly on each page;
   demos: the demos list, used to hide a demo link when that demo is hidden.
   data-track and data-terms feed the filter buttons (assets/js/filters.js). data-repo links
   the card to a GitHub repository (assets/js/github.js). #}
{% macro projectCard(project, root, headingLevel, demos) -%}
<li class="card" data-track="{{ project.category }}" data-terms="{{ project | projectTerms | join('|') }}"{% if not (project.repo | isPlaceholder) %} data-repo="{{ project.repo }}"{% endif %}>
  {%- if project.thumbnail %}
  <img class="card-thumb" src="{{ root }}{{ project.thumbnail }}" alt="{{ project.thumbnailAlt }}" width="1200" height="630" loading="lazy">
  {%- endif %}
  <h{{ headingLevel }} class="card-title">{{ project.title }}</h{{ headingLevel }}>
  {%- if project.status %}
  <p class="status status-{{ project.status | slugify }}">{{ project.status }}</p>
  {%- endif %}
  <p>{{ project.summary }}</p>
  <ul class="tags" aria-label="Technologies">
    {%- for tag in project.tags %}
    <li>{{ tag }}</li>
    {%- endfor %}
  </ul>
  <p class="gh-meta" hidden></p>
  <ul class="card-links">
    {%- if project.caseStudy %}
    <li><a href="{{ root }}projects/{{ project.slug }}.html">Case study<span class="visually-hidden">: {{ project.title }}</span></a></li>
    {%- endif %}
    {%- if project.demo and not (demos | findBySlug(project.demo)).hidden %}
    <li><a href="{{ root }}demos/{{ project.demo }}/">Demo<span class="visually-hidden">: {{ project.title }}</span></a></li>
    {%- endif %}
    {%- if project.demoUrl %}
    <li>{{ externalLink(project.demoUrl, "Live demo", project.title) }}</li>
    {%- endif %}
    <li>{{ externalLink(project.codeUrl, "Code", project.title) }}</li>
  </ul>
</li>
{%- endmacro %}
