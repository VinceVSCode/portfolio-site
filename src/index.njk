---
layout: base.njk
permalink: index.html
---
{#-
  Home page (served at /). Shows the intro from data/site.json, the featured
  projects (projects marked "featured" in data/projects.json), and contact links.
-#}
{%- from "macros.njk" import externalLink, projectCard -%}
{%- set root = page.url | rootPath -%}
{#- Introduction: name, headline, optional bio and photo, and the main buttons. -#}
<section class="hero" aria-labelledby="hero-heading">
  {%- if site.photo %}
  <img class="hero-photo" src="{{ root }}{{ site.photo }}" alt="{{ site.photoAlt }}" width="160" height="160">
  {%- endif %}
  <div>
    <h1 id="hero-heading">{{ site.name }}</h1>
    <p class="lead">{{ site.headline }}</p>
    {%- if site.bio %}
    <p>{{ site.bio }}</p>
    {%- endif %}
    <p class="hero-actions">
      <a class="button" href="{{ root }}projects/">See all projects</a>
      {%- if site.cvFile %}
      <a class="button button-secondary" href="{{ root }}{{ site.cvFile }}" download>Download CV (PDF)</a>
      {%- endif %}
    </p>
  </div>
</section>

<section class="section" aria-labelledby="featured-heading">
  <h2 id="featured-heading">Featured projects</h2>
  {#- Collect the visible projects marked as featured, in the order they appear in the data. -#}
  {%- set featured = [] %}
  {%- for project in catalog | visible %}{% if project.featured %}{% set featured = (featured.push(project), featured) %}{% endif %}{% endfor %}
  {%- if featured.length %}
  <ul class="card-grid">
    {%- for project in featured %}
    {{ projectCard(project, root, 3, demos) }}
    {%- endfor %}
  </ul>
  {%- else %}
  <p class="empty">No projects are published yet. The first ones are on their way, so please check back soon.</p>
  {%- endif %}
</section>

{#- Contact links. Placeholder values are shown as plain text until the owner fills them in. -#}
<section class="section" id="contact" aria-labelledby="contact-heading">
  <h2 id="contact-heading">Contact</h2>
  <ul class="contact-list">
    <li>
      {%- if site.email | isPlaceholder -%}
      <span class="pending">Email: {{ site.email }}</span>
      {%- else -%}
      <a href="mailto:{{ site.email }}">Email: {{ site.email }}</a>
      {%- endif -%}
    </li>
    <li>
      {%- if site.githubUsername | isPlaceholder -%}
      <span class="pending">GitHub: {{ site.githubUsername }}</span>
      {%- else -%}
      {{ externalLink("https://github.com/" + site.githubUsername, "GitHub", "", "button button-secondary") }}
      {%- endif -%}
    </li>
    <li>{{ externalLink(site.linkedinUrl, "LinkedIn", "", "button button-secondary") }}</li>
  </ul>
</section>
