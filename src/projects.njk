---
layout: base.njk
permalink: projects/index.html
title: Projects
description: All projects, with filters by technology and category.
scripts:
  - filters.js
  - github.js
---
{%- from "macros.njk" import projectCard -%}
{%- set root = page.url | rootPath -%}
{%- set shown = projects | visible -%}
<h1>Projects</h1>

{%- if shown.length %}

<div class="filters" id="project-filters" hidden>
  <p id="filters-label">Filter by technology or category:</p>
  <ul class="filter-list" aria-labelledby="filters-label">
    <li><button type="button" class="filter-button" data-term="" aria-pressed="true">All</button></li>
    {%- for term in shown | filterTerms %}
    <li><button type="button" class="filter-button" data-term="{{ term }}" aria-pressed="false">{{ term }}</button></li>
    {%- endfor %}
  </ul>
  <p id="filter-status" role="status" class="note"></p>
</div>

<ul class="card-grid" id="project-list">
  {%- for project in shown %}
  {{ projectCard(project, root, 2, demos) }}
  {%- endfor %}
</ul>
{%- else %}
<p class="empty">No projects are published yet. The first ones are on their way, so please check back soon.</p>
{%- endif %}

<section class="section" id="github-repos" data-github-user="{{ site.githubUsername }}" aria-labelledby="github-heading" hidden>
  <h2 id="github-heading">Recently updated on GitHub</h2>
  <ul class="repo-list"></ul>
  <p class="note">Loaded from the public GitHub API and cached in your browser for one hour.</p>
</section>
