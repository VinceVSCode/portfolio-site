---
layout: base.njk
permalink: projects/index.html
title: Projects
description: All projects, with filters by track and technology.
scripts:
  - filters.js
  - github.js
---
{#-
  Projects page (served at /projects/). Lists every visible project with
  filter buttons (filters.js) and an optional list of recent GitHub repositories
  (github.js). Both scripts are listed in the front matter above.
-#}
{%- from "macros.njk" import projectCard -%}
{%- set root = page.url | rootPath -%}
{#- Projects not hidden: data/projects.json merged with the GitHub manifests (data/catalog.js). -#}
{%- set shown = catalog | visible -%}
<h1>Projects</h1>

{%- if shown.length %}

{#- Filter bar. Hidden until filters.js runs, so it never shows without working buttons. -#}
<div class="filters" id="project-filters" hidden>
  <p id="track-label">Track:</p>
  <ul class="filter-list" aria-labelledby="track-label">
    <li><button type="button" class="filter-button" data-group="track" data-term="" aria-pressed="true">All</button></li>
    {%- for term in shown | trackTerms %}
    <li><button type="button" class="filter-button" data-group="track" data-term="{{ term }}" aria-pressed="false">{{ term }}</button></li>
    {%- endfor %}
  </ul>
  <p id="filters-label">Technology:</p>
  <ul class="filter-list" aria-labelledby="filters-label">
    <li><button type="button" class="filter-button" data-group="tag" data-term="" aria-pressed="true">All</button></li>
    {%- for term in shown | filterTerms %}
    <li><button type="button" class="filter-button" data-group="tag" data-term="{{ term }}" aria-pressed="false">{{ term }}</button></li>
    {%- endfor %}
  </ul>
  <p id="filter-status" role="status" class="note"></p>
</div>

<ul class="card-grid" id="project-list">
  {%- for project in shown %}
  {{ projectCard(project, root, 2, demos) }}
  {%- endfor %}
</ul>
{%- else %}
<p class="empty">No projects are published yet. The first ones are on their way, so please check back soon.</p>
{%- endif %}

{#- Recent GitHub repositories. Hidden until github.js fills it in; if that fails it stays hidden. -#}
<section class="section" id="github-repos" data-github-user="{{ site.githubUsername }}" aria-labelledby="github-heading" hidden>
  <h2 id="github-heading">Recently updated on GitHub</h2>
  <ul class="repo-list"></ul>
  <p class="note">Loaded from the public GitHub API and cached in your browser for one hour.</p>
</section>
